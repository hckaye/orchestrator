{
  "name": "orchestrator-desktop",
  "version": "0.1.4",
  "license": "MIT",
  "description": "Desktop UI for orchestrator worker sessions and live processes",
  "main": "electron/main.js",
  "type": "module",
  "author": "hckaye",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder",
    "pack:mac": "electron-builder --mac dir",
    "pack:win": "electron-builder --win dir",
    "pack:linux": "electron-builder --linux dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "install:app": "node scripts/install.js",
    "install:mac": "node scripts/install.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.hckaye.orchestrator-desktop",
    "productName": "Orchestrator",
    "copyright": "Copyright © hckaye",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Orchestrator",
        "CFBundleName": "Orchestrator",
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "Orchestrator"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Orchestrator-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage", "deb", "tar.gz"],
      "category": "Development"
    }
  }
}
